[Unit]
Description=PiNAS Monitor dashboard
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/pinas-monitor
Environment=PINAS_CSV=/var/log/pinas-smart/history.csv
Environment=PINAS_HOST=127.0.0.1
Environment=PINAS_PORT=8765
ExecStart=/home/YOUR_USERNAME/pinas-monitor/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
